{
  "name": "Jeffstein Theme",
  "dark": true,
  "author": "Jeffstein Cumjar",
  "editorScheme": "/JeffsteinTheme.xml",
  "colors": {
    "jetBlack": "#000000",
    "panelBg": "#111111",
    "text": "#FFFFFF",
    "sideText": "#CCCCCC",
    "muted": "#999999",
    "red": "#E60000",
    "redBright": "#E00000",
    "hover": "#2A2A2A",
    "dropdownBg": "#151515",
    "inputBg": "#191919"
  },
  "ui": {
    "*": {
      "background": "panelBg",
      "foreground": "text",
      "selectionBackground": "red",
      "selectionInactiveBackground": "#333333",
      "selectionForeground": "text"
    },
    "Window.background": "panelBg",
    "Panel.background": "panelBg",
    "Editor.background": "jetBlack",
    "Toolbar.background": "panelBg",
    "Toolbar.foreground": "sideText",
    "ToolWindow.background": "panelBg",
    "ToolWindow.foreground": "sideText",
    "Tree.background": "panelBg",
    "Tree.foreground": "sideText",
    "Table.background": "panelBg",
    "Table.foreground": "sideText",
    "Menu.background": "dropdownBg",
    "Menu.foreground": "text",
    "MenuItem.background": "dropdownBg",
    "MenuItem.foreground": "text",
    "Popup.background": "dropdownBg",
    "Popup.foreground": "text",
    "TextField.background": "inputBg",
    "TextField.foreground": "text",
    "ComboBox.background": "dropdownBg",
    "ComboBox.foreground": "text",
    "Button.background": "redBright",
    "Button.foreground": "text",
    "StatusBar.background": "red",
    "StatusBar.foreground": "text",
    "DefaultTabs.background": "jetBlack",
    "DefaultTabs.foreground": "text",
    "DefaultTabs.inactiveBackground": "#222222",
    "DefaultTabs.inactiveForeground": "muted",
    "DefaultTabs.underlineColor": "redBright",
    "EditorTabs.background": "jetBlack",
    "EditorTabs.foreground": "text",
    "EditorTabs.inactiveBackground": "#222222",
    "EditorTabs.inactiveForeground": "muted",
    "EditorTabs.underlineColor": "redBright",
    "Link.foreground": "#E0DC00"
  }
}
